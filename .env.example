# Copy to .env for local development. Never commit the real file.
# Every variable is optional: CampusAI runs with these defaults and needs no API key.

# Comma-separated list of origins allowed to call the API (the frontend's URL).
CORS_ORIGINS=http://localhost:5173

# Folder with your own campus documents (see data/documents/README.md).
# Defaults to the bundled sample documents.
# CAMPUSAI_DOCS_DIR=data/documents

# Per-client request limit and maximum message length.
RATE_LIMIT_PER_MINUTE=30
MAX_MESSAGE_LENGTH=500
